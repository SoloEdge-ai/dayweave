# The backend listens on loopback. Use the LAN HTTPS proxy for personal devices.
DAYWEAVE_PORT=8787
# Transactional email. Use starttls (587) or tls (465) with your SMTP relay.
DAYWEAVE_SMTP_HOST=
DAYWEAVE_SMTP_PORT=587
DAYWEAVE_SMTP_SECURITY=starttls
DAYWEAVE_SMTP_USER=
DAYWEAVE_SMTP_PASSWORD=
DAYWEAVE_MAIL_FROM=
# Accept account registration on the trusted network. Set to 0 to close registration.
DAYWEAVE_ENABLE_SIGNUP=1
# Enable only when accessing the app over HTTPS.
DAYWEAVE_COOKIE_SECURE=0
# For a host HTTPS proxy, use the exact Docker application bridge gateway address.
DAYWEAVE_PROXY_IP=127.0.0.1
# Optional exact HTTP base URLs for trusted local inference servers, comma separated.
DAYWEAVE_TRUSTED_HTTP_BASES=
