# Keep the backend on loopback. Use the LAN HTTPS proxy for personal devices.
DAYWEAVE_BIND=127.0.0.1
DAYWEAVE_PORT=8787
# Leave blank to generate a password inside the persistent volume on first boot.
DAYWEAVE_ADMIN_PASSWORD=
# Enable only when accessing the app over HTTPS.
DAYWEAVE_COOKIE_SECURE=0
# For a host HTTPS proxy, use the exact Docker application bridge gateway address.
DAYWEAVE_PROXY_IP=127.0.0.1
# Optional exact HTTP base URLs for trusted local inference servers, comma separated.
DAYWEAVE_TRUSTED_HTTP_BASES=
