{
	admin off
	auto_https disable_redirects
	skip_install_trust
	servers {
		protocols h1 h2
	}
}

https://{$DAYWEAVE_LAN_IP}:{$DAYWEAVE_LAN_HTTPS_PORT:8443} {
	bind {$DAYWEAVE_LAN_IP}
	tls internal

	@personal remote_ip {$DAYWEAVE_LAN_CLIENTS}
	handle @personal {
		reverse_proxy 127.0.0.1:{$DAYWEAVE_PORT:8787}
	}
	handle {
		respond 403
	}
}
